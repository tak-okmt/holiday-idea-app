# このファイルをコピーして .env.local を作り、実際の値を入れる。
# .env.local はコミットしない(.gitignoreで除外済み)。

# Jev (TypeSafe AI) のAPIキー。https://console.typesafe.ai/keys で発行する。
# 似た名前の別ドメインに注意(CLAUDE.mdのJevメモ参照)。
TYPESAFE_API_KEY=

# Supabase(ログ保存、週末7)。未設定でもアプリは動く(ログ保存だけスキップされる)。
# Supabaseダッシュボードの Project Settings > API から取得できる。
SUPABASE_URL=
SUPABASE_ANON_KEY=
